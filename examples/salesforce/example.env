# Salesforce example configuration
# Copy this file to .env in this same directory and fill in your values.
#
#   cp examples/salesforce/example.env examples/salesforce/.env
#
# The .env file is read automatically by the example scripts.
# Never commit .env to version control - it is already git-ignored.

# --- External Client App (ECA) credentials ------------------------------
# Found in: Setup -> External Client Apps -> <your app> -> Consumer Key and Secret

SF_CLIENT_ID=your_connected_app_consumer_key
SF_CLIENT_SECRET=your_connected_app_consumer_secret

# --- Token endpoint ------------------------------------------------------
# Production:  https://login.salesforce.com/services/oauth2/token
# Sandbox:     https://test.salesforce.com/services/oauth2/token

SF_TOKEN_URL=https://login.salesforce.com/services/oauth2/token

# --- Username/Password flow (see username_password.md) ------------------
# SF_SECURITY_TOKEN is optional. When set, it is automatically appended to
# SF_PASSWORD before the token request - matching Salesforce's requirement
# for orgs without IP allowlisting.
# Reset your token: Setup -> My Personal Information -> Reset Security Token

SF_USERNAME=your_salesforce_username@example.com
SF_PASSWORD=your_password
SF_SECURITY_TOKEN=your_security_token

# --- Demo settings -------------------------------------------------------
# Search term used in the SOSL quick search step (step 4).
# FIND {<value>} IN NAME FIELDS RETURNING Account(Id, Name) LIMIT 5

SF_DEMO_SEARCH_TERM=Inc

# --- API version (optional) ---------------------------------------------
# Defaults to the library default when not set.

# SF_API_VERSION=62.0# Salesforce example configuration
